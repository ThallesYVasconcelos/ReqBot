# Copie para docker/.env e preencha os valores.
# Exemplo, a partir da raiz do projeto:
# cp docker/.env.example docker/.env

# Obrigatório para IA e login
GEMINI_API_KEY=sua_chave_gemini_aqui
AUTH_JWT_SECRET=segredo_minimo_32_caracteres_aleatorios
AUTH_GOOGLE_CLIENT_ID=seu_client_id_google.apps.googleusercontent.com
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173,http://localhost:3000

# Ngrok é opcional, usado só para expor o backend local na internet.
NGROK_AUTHTOKEN=seu_token_ngrok
